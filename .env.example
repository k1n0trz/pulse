# --------- Pulse · environment variables (example) ---------
# Copy this file to `.env` at the repo root (or per-app `.env`) and fill in values.
# NEVER commit a real `.env` — it's gitignored.

# ----- Runtime -----
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# ----- Database (Fase 0) -----
# Neon / Supabase / local Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pulse?schema=public&sslmode=require

# ----- API auth (Fase 3) -----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-48-byte-random-hex-string

# ----- Meta Ads integration (Fase 1) -----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/v1/meta/oauth/callback
META_API_VERSION=v23.0

# ----- Anthropic (Fase 2) -----
ANTHROPIC_API_KEY=

# ----- CORS (comma-separated origins allowed to call the API) -----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Frontend (apps/web) -----
VITE_API_BASE_URL=http://localhost:4000
