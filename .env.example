# --------- Pulse · environment variables (example) ---------
# Copy this file to `.env` at the repo root (or per-app `.env`) and fill in values.
# NEVER commit a real `.env` — it's gitignored.

# ----- Runtime -----
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# ----- Database (Fase 0) -----
# Neon / Supabase / local Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pulse?schema=public&sslmode=require

# ----- Crypto (Fase 1) -----
# 64 hex chars (32 bytes) for AES-256-GCM. Used to encrypt Meta tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars-replace-with-64-hex-chars-replace-with-64

# ----- API auth (Fase 3) -----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-48-byte-random-hex-string

# Clerk (Fase 3c) — multi-tenant auth. When unset, the API runs single-tenant demo mode.
# See docs/AUTH_AND_REDIS_SETUP.md.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Frontend mirror of the publishable key (apps/web reads VITE_-prefixed vars):
VITE_CLERK_PUBLISHABLE_KEY=

# ----- Meta Ads integration (Fase 1) -----
# See docs/META_SETUP.md for how to obtain these.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/v1/meta/oauth/callback
META_API_VERSION=v23.0
META_DEFAULT_SCOPES=ads_read,ads_management,business_management,pages_show_list

# Where the API redirects users back to after OAuth completes.
WEB_APP_URL=http://localhost:5173

# ----- Sync scheduler (Fase 1) -----
# Disabled by default so it doesn't run during local dev unless you opt in.
ENABLE_SYNC_SCHEDULER=false
SYNC_NIGHTLY_CRON=0 3 * * *
SYNC_HOURLY_CRON=15 * * * *

# ----- Anthropic (Fase 2) -----
# Get one from https://console.anthropic.com — Pulse uses Claude Opus 4.7 as the brain
# and Claude Haiku 4.5 for light classification tasks. ~USD $100-200/mo to start.
ANTHROPIC_API_KEY=

# ----- Billing / Stripe (Fase 5) -----
# See docs/STRIPE_SETUP.md. Unset = billing endpoints return not_configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_SCALE=
BILLING_SUCCESS_URL=https://app.pulseads.app/billing/success
BILLING_CANCEL_URL=https://app.pulseads.app/billing/cancel

# ----- Billing / MercadoPago (Fase 2) -----
# LATAM gateway via Checkout Pro (one payment = one month). Charges in USD.
# Unset = MercadoPago endpoints return not_configured.
# Production credentials live in docs/temporal/mercadopago.txt (gitignored) — copy them here.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CURRENCY=USD
# Secret to verify MercadoPago webhook signatures (x-signature). Optional but recommended.
# The webhook URL is set per-preference automatically (no dashboard config needed).
MERCADOPAGO_WEBHOOK_SECRET=

# Public URL of THIS API — used to build the per-preference webhook notification_url.
# In production set it to e.g. https://api.pulseads.app
API_PUBLIC_URL=

# ----- Superadmin -----
# Comma-separated emails with permanent full access (bypass billing/plan limits).
SUPERADMIN_EMAILS=kinotrance@gmail.com

# ----- Landing (apps/landing) -----
# In production point this at the app domain so commercial-site CTAs open the app.
VITE_APP_URL=http://localhost:5173

# ----- Notifications (Fase 3) -----
# OneSignal (https://onesignal.com) — web push + email + SMS in one API.
# See docs/ONESIGNAL_SETUP.md for the 10-minute walkthrough.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
ONESIGNAL_FROM_EMAIL=Pulse <notifications@pulse.local>

# ----- Queues (Fase 3) -----
# Upstash Redis (https://upstash.com) — REQUIRED for BullMQ background jobs.
# When unset, Pulse runs jobs inline (fine for single-tenant dev). Flip ENABLE_BULLMQ=true to use Redis.
REDIS_URL=
ENABLE_BULLMQ=false

# ----- CORS (comma-separated origins allowed to call the API) -----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Frontend (apps/web) -----
VITE_API_BASE_URL=http://localhost:4000
