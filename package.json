{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse — AI agent for Meta Ads management and optimization",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "db:generate": "pnpm --filter @pulse/api db:generate",
    "db:migrate": "pnpm --filter @pulse/api db:migrate",
    "db:studio": "pnpm --filter @pulse/api db:studio"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
